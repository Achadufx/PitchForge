# Copy to .env.local for local dev, and set the same keys in Vercel for production.
# .env and .env.local are gitignored; this example file is not.

# --- Gemini (pitch generation + investor research + document analysis) ---
# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Leave unset to use the default in lib/geminiClient.js.
# Verify which models your key can reach with:  node scripts/test-gemini.js
#   gemini-2.5-flash  default; shutdown announced 2026-10-16
#   gemini-3.6-flash  current stable, no announced shutdown
#   gemini-2.0-flash  listed by Google as SHUT DOWN — do not use
#   gemini-1.5-flash  absent from Google's current model list — do not use
GEMINI_MODEL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email delivery (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Stripe dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# --- Apify (PitchBook investor scraping) ---
APIFY_API_TOKEN=
