# Copy to .env.local for local dev, and set the same keys in Vercel for production.
# .env and .env.local are gitignored; this example file is not.

# --- Groq (PITCH WRITING) ---
# Required. Free at https://console.groq.com — generous limits, no card needed.
# Writes the actual pitch emails. Without it, no pitch is generated.
GROQ_API_KEY=

# Optional model override. Leave unset to use the default in lib/groqClient.js.
# Verify which models your key can reach with:  node scripts/test-groq.js
#   llama-3.3-70b-versatile  default; DEPRECATED 2026-06-17, shutdown 2026-08-16
#   openai/gpt-oss-120b      Groq's recommended replacement
#   qwen/qwen3.6-27b         alternate replacement, smaller and faster
GROQ_MODEL=

# --- Gemini (INVESTOR RESEARCH + DOCUMENT ANALYSIS) ---
# Strongly recommended. Powers two things:
#   1. Investor research — Gemini's newer training cutoff gives better recall of
#      specific VCs and recent deals, especially outside the US.
#   2. Document upload (/api/analyze-documents, /api/extract-text) — reads images
#      and scanned PDF pages, which Groq's text-only llama models cannot do.
#
# Without it, pitches still generate but skip research, so they open on the
# problem rather than a verified fact about the investor. Document upload stops
# working entirely.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Leave unset to use the default in lib/geminiClient.js.
# Verify which models your key can reach with:  node scripts/test-gemini.js
#   gemini-3.6-flash  default; current stable, no announced shutdown
#   gemini-2.5-flash  shutdown announced 2026-10-16
#   gemini-2.0-flash  listed by Google as SHUT DOWN — do not use
#   gemini-1.5-flash  absent from Google's current model list — do not use
GEMINI_MODEL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email delivery (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# Signing secret for the delivery webhook, from the Resend dashboard.
# Without it /api/resend-webhook rejects every request, opened_at and
# replied_at stay NULL, and the CRM reply rate reads 0% forever.
#
# Register the endpoint at Resend → Webhooks → Add Endpoint:
#   https://pitchwire.vercel.app/api/resend-webhook
# Subscribe to: email.sent, email.delivered, email.opened, email.clicked,
#               email.bounced, email.complained
# Then copy the `whsec_...` signing secret here and into Vercel.
RESEND_WEBHOOK_SECRET=

# --- Scheduled jobs ---
# Shared secret for /api/cron/no-response, which runs daily at 09:00 UTC and
# moves investors with no reply after 14 days into the No Response stage.
# Generate with:  openssl rand -hex 32
# Vercel attaches `Authorization: Bearer $CRON_SECRET` to cron invocations
# automatically once this variable exists. Unset, the endpoint refuses to run.
CRON_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Stripe dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Monthly prices. Required for paid checkout to work at all.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Annual prices. OPTIONAL — create these as recurring yearly prices in Stripe
# ($276/year Starter, $758/year Pro). If either is left unset, a founder who
# picks "Annual" at checkout is silently billed on the matching monthly price
# instead, with a warning logged server-side. Nothing 500s and no one is
# blocked, but they pay monthly while the UI showed them an annual total —
# so set both before advertising annual billing in production.
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# --- Apify (PitchBook investor scraping) ---
APIFY_API_TOKEN=
