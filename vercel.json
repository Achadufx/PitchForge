{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "functions": {
    "pages/api/**/*.{js,ts}": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/no-response",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/gmail-sync",
      "schedule": "0 10 * * *"
    }
  ]
}
